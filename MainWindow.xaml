<Window x:Class="EXPasteWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EXPasteWPF"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        Title="EXPaste" Height="600" Width="800" WindowStartupLocation="CenterScreen" AllowsTransparency="True"
        Background="Transparent" WindowStyle="None" ResizeMode="CanResize"
        MinWidth="580" MinHeight="440">

    <Grid>
        <!--背景 Grid-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="200" CornerRadius="10 0 0 10" MouseLeftButtonDown="BackgroundBorder_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#343155" Offset="0"/>
                        <GradientStop Color="#26324C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border CornerRadius="0 10 10 0" Grid.Column="1" MouseLeftButtonDown="BackgroundBorder_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#39355E" Offset="0"/>
                        <GradientStop Color="#2B3752" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!--窗口控制按钮（三大金刚键：最小化 / 最大化 / 关闭）-->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Panel.ZIndex="100" Height="32" Margin="0">
            <Button x:Name="BtnMinimize" Style="{StaticResource windowControlButton}"
                    Click="BtnMinimize_Click" ToolTip="最小化">
                <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
            <Button x:Name="BtnMaximize" Style="{StaticResource windowControlButton}"
                    Click="BtnMaximize_Click" ToolTip="最大化/还原">
                <Path x:Name="MaximizeIcon" Data="M0,0 L10,0 L10,10 L0,10 Z"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" Fill="Transparent"/>
            </Button>
            <Button x:Name="BtnClose" Style="{StaticResource windowCloseButton}"
                    Click="BtnClose_Click" ToolTip="关闭">
                <Path Data="M0,0 L10,10 M10,0 L0,10"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
        </StackPanel>

        <!--控制-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--主菜单（Grid 布局：顶部 logo+模式按钮，中间自适应间隔，底部 设置+关于）-->
            <Grid Width="240">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="-19 40 20 40" HorizontalAlignment="Center">
                        <fa:ImageAwesome Icon="Bug" Foreground="Gray" Width="35"/>
                        <TextBlock Text="EXPaste" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" Foreground="Gray" Margin="10 0 0 0"/>
                    </StackPanel>
                    <!--文件模式-->
                    <Button x:Name="BtnFileMode" Style="{StaticResource activeMenuButton}" Width="209" HorizontalAlignment="Left" Click="BtnFileMode_Click">
                        <Grid Margin="-18,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="28,0,0,0">
                                <fa:ImageAwesome Icon="File" Style="{StaticResource buttonIcon}"/>
                                <TextBlock Text="选择文件模式(拖)" Style="{StaticResource buttonText}"/>
                            </StackPanel>
                            <fa:ImageAwesome Icon="AngleRight" HorizontalAlignment="Right" Margin="-14" Visibility="Visible" Style="{StaticResource buttonIconExpanded}"/>
                        </Grid>
                    </Button>
                    <!--文本编辑模式-->
                    <Button x:Name="BtnTextEditMode" Style="{StaticResource menuButton}" Width="209" HorizontalAlignment="Left" Click="BtnTextEditMode_Click">
                        <Grid Margin="-18,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="28,0,0,0">
                                <fa:ImageAwesome Icon="Edit" Style="{StaticResource buttonIcon}"/>
                                <TextBlock Text="文本编辑模式" Style="{StaticResource buttonText}"/>
                            </StackPanel>
                            <fa:ImageAwesome Icon="AngleRight" HorizontalAlignment="Right" Margin="-14" Visibility="Visible" Style="{StaticResource buttonIconExpanded}"/>
                        </Grid>
                    </Button>
                    <!--编译器模式-->
                    <Button x:Name="BtnCompilerMode" Style="{StaticResource menuButton}" Width="209" HorizontalAlignment="Left" Click="BtnCompilerMode_Click">
                        <Grid Margin="-18,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="28,0,0,0">
                                <fa:ImageAwesome Icon="Code" Style="{StaticResource buttonIcon}"/>
                                <TextBlock Text="编译器模式" Style="{StaticResource buttonText}"/>
                            </StackPanel>
                            <fa:ImageAwesome Icon="AngleRight" HorizontalAlignment="Right" Margin="-14" Visibility="Visible" Style="{StaticResource buttonIconExpanded}"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!--Row 1 为空，作为自适应间隔，窗口缩放时此处随之变化-->

                <StackPanel Grid.Row="2">
                    <!--设置-->
                    <Button x:Name="BtnSettings" Style="{StaticResource menuButton}" Width="209" HorizontalAlignment="Left" Click="BtnSettings_Click">
                        <Grid Margin="-18,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="28,0,0,0">
                                <fa:ImageAwesome Icon="Gear" Style="{StaticResource buttonIcon}"/>
                                <TextBlock Text="设置" Style="{StaticResource buttonText}"/>
                            </StackPanel>
                            <fa:ImageAwesome Icon="AngleRight" HorizontalAlignment="Right" Margin="-14" Visibility="Visible" Style="{StaticResource buttonIconExpanded}"/>
                        </Grid>
                    </Button>
                    <!--关于-->
                    <Button x:Name="BtnAbout" Style="{StaticResource menuButton}" Width="209" HorizontalAlignment="Left" Click="BtnAbout_Click">
                        <Grid Margin="-18,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="28,0,0,0">
                                <fa:ImageAwesome Icon="Commenting" Style="{StaticResource buttonIcon}"/>
                                <TextBlock Text="关于/反馈" Style="{StaticResource buttonText}"/>
                            </StackPanel>
                            <fa:ImageAwesome Icon="AngleRight" HorizontalAlignment="Right" Margin="-14" Visibility="Visible" Style="{StaticResource buttonIconExpanded}"/>
                        </Grid>
                    </Button>
                    <Separator Background="Gray" Opacity="0" Margin="0,0,0,0" Height="6" Width="146"/>
                </StackPanel>
            </Grid>

            <!--内容区-->
            <Grid Grid.Column="1" Grid.ColumnSpan="2" Margin="3,3,3,3">

                <!-- ========== 文件模式 ========== -->
                <Grid x:Name="FileModePanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!--标题部分-->
                    <StackPanel Grid.Row="0" Margin="20,24,20,6">
                        <TextBlock Text="欢迎使用EXPaste" Style="{StaticResource sectionTitle}"/>
                        <TextBlock Text="请将文件拖到下面的框中，或者在下方粘贴文件路径后点击“浏览文件...”" Style="{StaticResource sectionSubtitle}"/>
                    </StackPanel>

                    <!--拖放预览窗口（只读 TextBlock，与拖放协调，避免 TextBox 拦截拖放事件）-->
                    <Border x:Name="DropBorder" Grid.Row="1" Margin="20,8,20,8"
                            Style="{StaticResource border}"
                            AllowDrop="True" DragEnter="DropBorder_DragEnter" Drop="DropBorder_Drop"
                            Background="#3a3450" BorderBrush="#5a5278" ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      CanContentScroll="True">
                            <TextBlock x:Name="FilePreviewText"
                                       Text="拖放文件到此处&#x000A;或点击下方“浏览文件...”"
                                       TextWrapping="NoWrap"
                                       Foreground="#C7D1D1" FontSize="14" FontFamily="Microsoft YaHei"
                                       Padding="6"/>
                        </ScrollViewer>
                    </Border>

                    <!--倒计时显示区（预览与底部按钮之间，预留 18px）-->
                    <TextBlock x:Name="FileCountdownText" Grid.Row="2" Text="" Height="18"
                               Foreground="#d489ff" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="20,2,20,2"/>

                    <!--底部：粘贴路径 + 浏览文件 + 开始粘贴-->
                    <Grid Grid.Row="3" Margin="20,8,20,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathTextBox" Grid.Column="0" Style="{StaticResource pathDisplayBox}"
                                 Margin="0,0,10,0" Height="34"
                                 ToolTip="粘贴文件路径，多个路径用分号分隔"
                                 TextChanged="PathTextBox_TextChanged"/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览文件..."
                                Style="{StaticResource contentButton}" Height="34" Margin="0,0,8,0"
                                Click="BrowseButton_Click"/>
                        <Button x:Name="FileStartPasteBtn" Grid.Column="2" Content="开始粘贴"
                                Style="{StaticResource contentButton}" Height="34" Margin="0,0,8,0"
                                Click="FileStartPasteBtn_Click"/>
                        <Button x:Name="FileStopPasteBtn" Grid.Column="3" Content="停止"
                                Style="{StaticResource contentButton}" Height="34" IsEnabled="False"
                                Click="StopPasteBtn_Click"/>
                    </Grid>
                </Grid>

                <!-- ========== 文本编辑模式 ========== -->
                <Grid x:Name="TextEditModePanel" Visibility="Hidden">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20,24,20,6">
                        <TextBlock Text="文本编辑模式" Style="{StaticResource sectionTitle}"/>
                        <TextBlock Text="在此粘贴或输入文本内容，点击“开始粘贴”将自动输入到目标窗口" Style="{StaticResource sectionSubtitle}"/>
                    </StackPanel>

                    <TextBox x:Name="TextEditBox" Grid.Row="1" Margin="20,8,20,8"
                             Style="{StaticResource contentTextBoxMulti}"
                             AcceptsReturn="True" AcceptsTab="True"/>

                    <TextBlock x:Name="TextEditCountdownText" Grid.Row="2" Text="" Height="18"
                               Foreground="#d489ff" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="20,2,20,2"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,4,20,20">
                        <Button x:Name="TextEditClearBtn" Content="清空"
                                Style="{StaticResource contentButton}" Height="34" Margin="0,0,8,0"
                                Click="TextEditClearBtn_Click"/>
                        <Button x:Name="TextEditStartPasteBtn" Content="开始粘贴"
                                Style="{StaticResource contentButton}" Height="34" Margin="0,0,8,0"
                                Click="TextEditStartPasteBtn_Click"/>
                        <Button x:Name="TextEditStopPasteBtn" Content="停止"
                                Style="{StaticResource contentButton}" Height="34" IsEnabled="False"
                                Click="StopPasteBtn_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ========== 编译器模式 ========== -->
                <Grid x:Name="CompilerModePanel" Visibility="Hidden">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20,24,20,6">
                        <TextBlock Text="编译器模式" Style="{StaticResource sectionTitle}"/>
                        <TextBlock Text="粘贴代码时将自动去除每行行首的制表符(Tab)缩进，使其正常粘贴" Style="{StaticResource sectionSubtitle}"/>
                    </StackPanel>

                    <TextBox x:Name="CompilerTextBox" Grid.Row="1" Margin="20,8,20,8"
                             Style="{StaticResource contentTextBoxMulti}"
                             AcceptsReturn="True" AcceptsTab="False"
                             DataObject.Pasting="CompilerTextBox_Paste"/>

                    <TextBlock x:Name="CompilerCountdownText" Grid.Row="2" Text="" Height="18"
                               Foreground="#d489ff" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="20,2,20,2"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,4,20,20">
                        <Button x:Name="CompilerClearBtn" Content="清空"
                                Style="{StaticResource contentButton}" Height="34" Margin="0,0,8,0"
                                Click="CompilerClearBtn_Click"/>
                        <Button x:Name="CompilerStartPasteBtn" Content="开始粘贴"
                                Style="{StaticResource contentButton}" Height="34" Margin="0,0,8,0"
                                Click="CompilerStartPasteBtn_Click"/>
                        <Button x:Name="CompilerStopPasteBtn" Content="停止"
                                Style="{StaticResource contentButton}" Height="34" IsEnabled="False"
                                Click="StopPasteBtn_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ========== 设置 ========== -->
                <Grid x:Name="SettingsPanel" Visibility="Hidden">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,24,20,8">
                        <TextBlock Text="设 置" Style="{StaticResource sectionTitle}" HorizontalAlignment="Center" Margin="0, 0 ,30 ,0"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="5,0,20,4">
                        <StackPanel>

                            <!--粘贴倒计时秒数-->
                            <TextBlock Text="粘贴倒计时秒数" Style="{StaticResource settingsLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Slider x:Name="CountdownSlider" Width="200" Minimum="1" Maximum="60"
                                        Value="3" IsSnapToTickEnabled="True" TickFrequency="1"
                                        ValueChanged="CountdownSlider_ValueChanged">
                                    <Slider.ToolTip>
                                        <ToolTip Background="Transparent" BorderThickness="0" Padding="0">
                                            <Border Background="#A59CC4" CornerRadius="6" Padding="8,6">
                                                <TextBlock Text="1 ~ 60 秒" Foreground="Black" FontSize="13"/>
                                            </Border>
                                        </ToolTip>
                                    </Slider.ToolTip>
                                </Slider>
                                <TextBlock x:Name="CountdownValueText" Text="3 秒"
                                           Foreground="#E0E0E0" FontSize="13"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <CheckBox x:Name="EnableHotkeyCheckBox" Content="启用快捷键"
                                      Style="{StaticResource settingsCheckBox}"
                                      IsChecked="False"
                                      Checked="EnableHotkeyCheckBox_Changed"
                                      Unchecked="EnableHotkeyCheckBox_Changed">
                                <CheckBox.ToolTip>
                                    <ToolTip Background="Transparent" BorderThickness="0" Padding="0">
                                        <Border Background="#A59CC4" CornerRadius="6" Padding="8,6">
                                            <StackPanel>
                                                <TextBlock Text="关闭时保存后设置仍保留" Foreground="Black" FontSize="13"/>
                                                <TextBlock Text="BackSpace清除当前快捷键，别忘保存喵" Foreground="Black" FontSize="13"/>
                                            </StackPanel>
                                        </Border>
                                    </ToolTip>
                                </CheckBox.ToolTip>
                            </CheckBox>

                            <Border Background="#4B4466" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="HotkeyErrorText" Text=""
                                               Foreground="#ff6b6b" FontSize="12" Margin="0,0,0,4"
                                               TextWrapping="Wrap"/>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="选择文件模式" Style="{StaticResource settingsLabel}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <Border x:Name="FileHotkeyDisplay" Grid.Column="1"
                                                Style="{StaticResource hotkeyDisplayBorder}"
                                                MinWidth="160" HorizontalAlignment="Right"
                                                MouseLeftButtonDown="HotkeyDisplay_MouseDown"
                                                Tag="File">
                                            <TextBlock x:Name="FileHotkeyText" Text=""
                                                       Foreground="#E0E0E0" FontSize="13"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="文本编辑模式" Style="{StaticResource settingsLabel}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <Border x:Name="TextEditHotkeyDisplay" Grid.Column="1"
                                                Style="{StaticResource hotkeyDisplayBorder}"
                                                MinWidth="160" HorizontalAlignment="Right"
                                                MouseLeftButtonDown="HotkeyDisplay_MouseDown"
                                                Tag="TextEdit">
                                            <TextBlock x:Name="TextEditHotkeyText" Text=""
                                                       Foreground="#E0E0E0" FontSize="13"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="编译器模式" Style="{StaticResource settingsLabel}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <Border x:Name="CompilerHotkeyDisplay" Grid.Column="1"
                                                Style="{StaticResource hotkeyDisplayBorder}"
                                                MinWidth="160" HorizontalAlignment="Right"
                                                MouseLeftButtonDown="HotkeyDisplay_MouseDown"
                                                Tag="Compiler">
                                            <TextBlock x:Name="CompilerHotkeyText" Text=""
                                                       Foreground="#E0E0E0" FontSize="13"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="开始/暂停/继续" Style="{StaticResource settingsLabel}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <Border x:Name="PauseResumeHotkeyDisplay" Grid.Column="1"
                                                Style="{StaticResource hotkeyDisplayBorder}"
                                                MinWidth="160" HorizontalAlignment="Right"
                                                MouseLeftButtonDown="HotkeyDisplay_MouseDown"
                                                Tag="PauseResume">
                                            <TextBlock x:Name="PauseResumeHotkeyText" Text=""
                                                       Foreground="#E0E0E0" FontSize="13"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,4,20,20">
                        <Button x:Name="SaveSettingsBtn" Content="保存"
                                Style="{StaticResource contentButton}"
                                Width="80" Height="34"
                                IsEnabled="False" Opacity="0.4"
                                Click="SaveSettingsBtn_Click"
                                ToolTip="保存当前设置更改"/>
                    </StackPanel>
                </Grid>

                <!-- ========== 关于 ========== -->
                <Grid x:Name="AboutPanel" Visibility="Hidden">
                    <StackPanel Margin="20,24,20,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fa:ImageAwesome Icon="Bug" Foreground="Gray" Width="60" Height="60"
                                         HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="EXPaste" FontSize="32" FontWeight="Bold"
                                   Foreground="#C7D1D1" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="一个简单易用的粘贴辅助工具" Foreground="#8A8A8A"
                                   FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <TextBlock Foreground="#B0B0B0" FontSize="14" HorizontalAlignment="Center"
                                   Margin="0,0,0,6">
                            <Run Text="作者："/>
                            <Run Text="2ffjc" Foreground="#C7D1D1"/>
                        </TextBlock>

                        <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Hyperlink NavigateUri="https://github.com/2ffjc/EXPaste"
                                       Foreground="#7989ff" FontSize="14"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                https://github.com/2ffjc/EXPaste
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
